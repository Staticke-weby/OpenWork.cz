---
// Ústřední diagram úvodní stránky: „licence za hlavu" vs. „společná peněženka".
// Barvy výhradně přes CSS proměnné Starlightu (fungují ve světlém i tmavém
// režimu). Text česky. Bez tváří — postavičky jsou jen silueta.

// Silueta postavičky: hlava (kruh) + ramena (oblouk). Vrací části pro <g>.
function tvarTela(x: number, y: number): string {
  return `M ${x - 17} ${y + 40} C ${x - 17} ${y + 15}, ${x + 17} ${y + 15}, ${x + 17} ${y + 40} Z`;
}

// Levý panel: pět postaviček v řadě, u každé cedulka „paušál".
const vlevo = [50, 112, 174, 236, 298].map((x) => ({ x, y: 96 }));

// Pravý panel: pět postaviček kolem společné peněženky uprostřed.
const penezenka = { x: 552, y: 150 };
const vpravo = [
  { x: 472, y: 74 },
  { x: 632, y: 74 },
  { x: 444, y: 168 },
  { x: 660, y: 168 },
  { x: 552, y: 250 },
];
---

<figure class="ow-diagram">
  <svg
    viewBox="0 0 720 340"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="dgm-title dgm-desc"
  >
    <title id="dgm-title">Paušál za každého člověka proti jedné společné peněžence</title>
    <desc id="dgm-desc">
      Vlevo pět lidí, každý platí svůj vlastní paušál, dole velký součet. Vpravo
      stejných pět lidí sdílí jednu peněženku; každý má svůj klíč a platí se jen
      za to, co kdo spotřebuje.
    </desc>

    <!-- Nadpisy panelů -->
    <text class="nadpis" x="174" y="26" text-anchor="middle">Za každého člověka paušál</text>
    <text class="nadpis" x="552" y="26" text-anchor="middle">Jedna společná peněženka</text>

    <!-- Předěl mezi panely -->
    <line class="delitko" x1="360" y1="44" x2="360" y2="300" />

    <!-- LEVÝ PANEL -->
    {
      vlevo.map((f) => (
        <g class="figura">
          <circle cx={f.x} cy={f.y} r="10" />
          <path d={tvarTela(f.x, f.y)} />
          <rect class="cedulka" x={f.x - 24} y={f.y + 50} width="48" height="20" rx="4" />
          <text class="cedulka-text" x={f.x} y={f.y + 64} text-anchor="middle">
            paušál
          </text>
        </g>
      ))
    }
    <line class="delitko" x1="30" y1="196" x2="318" y2="196" />
    <text class="soucet" x="174" y="224" text-anchor="middle">5 × paušál = velká částka</text>

    <!-- PRAVÝ PANEL -->
    <!-- Klíče: od každé postavičky vede vlastní čára do peněženky -->
    {
      vpravo.map((f) => (
        <g class="klic">
          <line x1={f.x} y1={f.y + 20} x2={penezenka.x} y2={penezenka.y} />
          <circle class="klic-hlava" cx={f.x} cy={f.y + 20} r="4" />
        </g>
      ))
    }

    <!-- Společná peněženka uprostřed -->
    <g class="penezenka">
      <rect x={penezenka.x - 46} y={penezenka.y - 30} width="92" height="60" rx="9" />
      <path
        class="penezenka-klopa"
        d={`M ${penezenka.x - 46} ${penezenka.y - 12} h 92`}
      />
      <circle class="penezenka-cvok" cx={penezenka.x + 30} cy={penezenka.y + 4} r="5" />
    </g>

    <!-- Postavičky vpravo (kresleny přes klíče) -->
    {
      vpravo.map((f) => (
        <g class="figura">
          <circle cx={f.x} cy={f.y} r="10" />
          <path d={tvarTela(f.x, f.y)} />
        </g>
      ))
    }

    <text class="soucet" x="552" y="312" text-anchor="middle">platíte jen, co kdo spotřebuje</text>
  </svg>
  <figcaption>Místo paušálu za každého člověka jedna společná peněženka — a vlastní klíč pro každého.</figcaption>
</figure>

<style>
  .ow-diagram {
    margin: 2rem 0;
    max-width: 46rem;
  }
  .ow-diagram svg {
    width: 100%;
    height: auto;
  }
  .figura circle,
  .figura path {
    fill: var(--sl-color-gray-3);
  }
  .cedulka {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }
  .cedulka-text {
    fill: var(--sl-color-gray-1);
    font-size: 12px;
  }
  .nadpis {
    fill: var(--sl-color-text);
    font-size: 16px;
    font-weight: 600;
  }
  .soucet {
    fill: var(--sl-color-text);
    font-size: 15px;
    font-weight: 600;
  }
  .delitko {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }
  .penezenka rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
    stroke-width: 2;
  }
  .penezenka-klopa {
    stroke: var(--sl-color-accent);
    stroke-width: 2;
    fill: none;
  }
  .penezenka-cvok {
    fill: var(--sl-color-accent);
  }
  .klic line {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .klic-hlava {
    fill: var(--sl-color-accent);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
