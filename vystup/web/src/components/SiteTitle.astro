---
// Vlastní logo v hlavičce (nahrazuje výchozí Starlight SiteTitle).
// Čistý wordmark bez ikony — „.cz" v barvě značky. Barvy přes CSS proměnné.
const jeSk = Astro.currentLocale === 'sk';
const domu = jeSk ? '/sk/' : '/';
---

<a href={domu} class="ow-logo" aria-label="OpenWork.cz — domů">
  <span class="ow-logo__name">OpenWork</span><span class="ow-logo__tld">.cz</span>
</a>

<style>
  .ow-logo {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .ow-logo__name {
    color: var(--sl-color-white);
  }
  .ow-logo__tld {
    color: var(--sl-color-accent);
  }
</style>
