---
// Vlastní logo v hlavičce (nahrazuje výchozí Starlight SiteTitle).
// Bez pozadí: textový tag [OW] v barvě značky + wordmark „OpenWork.cz".
const jeSk = Astro.currentLocale === 'sk';
const domu = jeSk ? '/sk/' : '/';
---

<a href={domu} class="ow-logo" aria-label="OpenWork.cz — domů">
  <span class="ow-logo__tag"
    ><span class="ow-logo__brk">[</span><span class="ow-logo__ow">OW</span><span class="ow-logo__brk">]</span></span
  >
  <span class="ow-logo__word">
    <span class="ow-logo__name">OpenWork</span><span class="ow-logo__tld">.cz</span>
  </span>
</a>

<style>
  .ow-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    line-height: 1;
  }
  .ow-logo__tag {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }
  .ow-logo__brk {
    color: var(--sl-color-accent);
  }
  .ow-logo__ow {
    color: var(--sl-color-gray-2);
  }
  .ow-logo__word {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .ow-logo__name {
    color: var(--sl-color-white);
  }
  .ow-logo__tld {
    color: var(--sl-color-accent);
  }
</style>
